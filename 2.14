# Tên file: bai_2_14_logistics.py
import numpy as np
import skfuzzy as fuzz
from skfuzzy import control as ctrl

#Biến đầu vaof
mat_do = ctrl.Antecedent(np.arange(0, 101, 1), 'mat_do')
khan_cap = ctrl.Antecedent(np.arange(0, 101, 1), 'khan_cap')
tai_trong = ctrl.Antecedent(np.arange(0, 101, 1), 'tai_trong')
giao_thong = ctrl.Antecedent(np.arange(0, 101, 1), 'giao_thong')
loi_nhuan = ctrl.Antecedent(np.arange(0, 101, 1), 'loi_nhuan')

#Biến đầu ra 
ket_hop = ctrl.Consequent(np.arange(1, 11, 1), 'ket_hop') # Gom từ 1 đến 10 đơn hàng
uu_tien = ctrl.Consequent(np.arange(0, 101, 1), 'uu_tien') # Ưu tiên từ 0-100%

# Chia tự động 3 mức cho biến đầu vào
mat_do.automf(3, names=['thap', 'trung_binh', 'cao'])
khan_cap.automf(3, names=['thap', 'trung_binh', 'cao'])
tai_trong.automf(3, names=['thap', 'trung_binh', 'cao'])
giao_thong.automf(3, names=['thap', 'trung_binh', 'cao'])
loi_nhuan.automf(3, names=['thap', 'trung_binh', 'cao'])

# Biến đầu ra: Số đơn hàng (Ít, Một vài/Một số, Nhiều)
ket_hop['it'] = fuzz.trimf(ket_hop.universe, [1, 1, 3])
ket_hop['mot_vai'] = fuzz.trimf(ket_hop.universe, [2, 5, 8])
ket_hop['nhieu'] = fuzz.trimf(ket_hop.universe, [7, 10, 10])

# Đầu ra: Ưu tiên (Thấp, Trung bình, Cao)
uu_tien.automf(3, names=['thap', 'trung_binh', 'cao'])

# Luật Fuzzy
rule1 = ctrl.Rule(mat_do['cao'] & tai_trong['thap'] & giao_thong['thap'], ket_hop['nhieu'])
rule2 = ctrl.Rule(mat_do['trung_binh'] & giao_thong['trung_binh'] & khan_cap['trung_binh'], ket_hop['mot_vai'])
rule3 = ctrl.Rule(tai_trong['cao'] & mat_do['cao'] & loi_nhuan['trung_binh'], ket_hop['mot_vai'])
rule4 = ctrl.Rule(mat_do['thap'] & khan_cap['cao'] & giao_thong['trung_binh'], ket_hop['mot_vai'])
rule5 = ctrl.Rule(loi_nhuan['cao'] & khan_cap['cao'] & giao_thong['cao'], ket_hop['mot_vai'])

# Nhóm luật ưu tiên giao hàng --
rule6 = ctrl.Rule(khan_cap['cao'] & loi_nhuan['cao'], uu_tien['cao'])
rule7 = ctrl.Rule(khan_cap['trung_binh'] & giao_thong['trung_binh'], uu_tien['trung_binh'])
rule8 = ctrl.Rule(khan_cap['thap'] & mat_do['cao'] & loi_nhuan['thap'], uu_tien['thap'])

he_thong_giao_hang = ctrl.ControlSystem([rule1, rule2, rule3, rule4, rule5, rule6, rule7, rule8])
mo_phong_giao_hang = ctrl.ControlSystemSimulation(he_thong_giao_hang)

# Bài DỮ LIỆU ĐẦU VÀO THỰC TẾ (Cuối trang 93)
mo_phong_giao_hang.input['mat_do'] = 85        # Cao
mo_phong_giao_hang.input['khan_cap'] = 50      # Trung bình
mo_phong_giao_hang.input['tai_trong'] = 15     # Thấp
mo_phong_giao_hang.input['giao_thong'] = 50    # Trung bình
mo_phong_giao_hang.input['loi_nhuan'] = 50     # Trung bình

mo_phong_giao_hang.compute()

print("--- KẾT QUẢ BÀI 2.14 ---")
print(f"Số lượng đơn hàng hệ thống đề xuất gom: ~ {int(mo_phong_giao_hang.output['ket_hop'])} đơn")
print(f"Mức độ ưu tiên giao hàng: {mo_phong_giao_hang.output['uu_tien']:.2f} % (Mức Trung bình)")
print("=> Kết quả khớp hoàn toàn với đề xuất chỉ định 5 lần giao hàng của sách!")
